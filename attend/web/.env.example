# ── Supabase ─────────────────────────────────────────────────────────────────
# Lấy từ: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key — chỉ dùng server-side, KHÔNG public
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Database (Drizzle) ───────────────────────────────────────────────────────
# Lấy từ: Supabase Dashboard → Settings → Database → Connection string (URI mode)
# Dùng connection pooling (port 6543) cho serverless
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Lấy từ: resend.com → API Keys
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=chamcong@latio.vn

# ── Inngest (Background Jobs) ────────────────────────────────────────────────
# Lấy từ: app.inngest.com → Settings
INNGEST_EVENT_KEY=...
INNGEST_SIGNING_KEY=signkey-...

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Tạo tại: console.cloud.google.com → APIs & Services → Credentials
# Nhớ thêm vào Supabase Auth → Providers → Google
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
