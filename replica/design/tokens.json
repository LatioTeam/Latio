{
  "_about": "Design tokens for LATIO Attendance App. Roles are fixed — replica-brand swaps values only. Run: python3 contrast.py replica/design/tokens.json",
  "_note": "Palette is a neutral placeholder. Brand colours assigned in /replica-brand. No AtWork colours used.",

  "color": {
    "bg":           "#ffffff",
    "bg-subtle":    "#f8f9fb",
    "surface":      "#f1f3f6",
    "surface-raised":"#ffffff",
    "border":       "#dde1e7",
    "border-input": "#8c95a0",
    "border-focus": "#3d6bff",

    "text":         "#111827",
    "text-muted":   "#4b5563",
    "text-subtle":  "#9ca3af",
    "text-on-dark": "#ffffff",

    "accent":       "#1e4fd4",
    "accent-hover": "#1740b8",
    "accent-subtle":"#eef2ff",
    "on-accent":    "#ffffff",

    "success":      "#15803d",
    "success-bg":   "#f0fdf4",
    "on-success":   "#ffffff",

    "danger":       "#b91c1c",
    "danger-bg":    "#fef2f2",
    "on-danger":    "#ffffff",

    "warning":      "#b45309",
    "warning-bg":   "#fffbeb",
    "on-warning":   "#ffffff",

    "info":         "#0369a1",
    "info-bg":      "#f0f9ff",

    "checkin":      "#15803d",
    "checkout":     "#b91c1c",
    "late":         "#b45309",
    "absent":       "#4b5563",
    "leave":        "#6d28d9",
    "ot":           "#0369a1",

    "nav-bg":       "#0f172a",
    "nav-text":     "#cbd5e1",
    "nav-active":   "#60a5fa",
    "nav-active-bg":"#1e3a8a"
  },

  "pairs": [
    ["text",         "bg"],
    ["text",         "surface"],
    ["text",         "bg-subtle"],
    ["text-muted",   "bg"],
    ["text-muted",   "surface"],
    ["text-muted",   "bg-subtle"],
    ["on-accent",    "accent"],
    ["on-accent",    "accent-hover"],
    ["accent",       "bg"],
    ["accent",       "accent-subtle"],
    ["danger",       "bg"],
    ["danger",       "danger-bg"],
    ["success",      "bg"],
    ["success",      "success-bg"],
    ["warning",      "bg"],
    ["warning",      "warning-bg"],
    ["border-input", "bg", "ui"],
    ["border-focus", "bg", "ui"],
    ["nav-text",     "nav-bg"],
    ["nav-active",   "nav-bg"],
    ["text-on-dark", "nav-bg"]
  ],

  "font": {
    "sans": "'Inter', 'Be Vietnam Pro', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace"
  },

  "type": {
    "xs":      { "size": 11, "line": 16, "weight": 500,  "tracking": "0.02em" },
    "sm":      { "size": 13, "line": 20, "weight": 400,  "tracking": "0" },
    "base":    { "size": 15, "line": 24, "weight": 400,  "tracking": "0" },
    "md":      { "size": 16, "line": 24, "weight": 500,  "tracking": "0" },
    "lg":      { "size": 18, "line": 28, "weight": 600,  "tracking": "-0.01em" },
    "xl":      { "size": 22, "line": 30, "weight": 700,  "tracking": "-0.02em" },
    "display": { "size": 32, "line": 40, "weight": 700,  "tracking": "-0.03em" },
    "clock":   { "size": 48, "line": 56, "weight": 700,  "tracking": "-0.03em" }
  },

  "space": [0, 4, 8, 12, 16, 20, 24, 32, 40, 48, 64, 80, 96],

  "radius": {
    "xs":   4,
    "sm":   8,
    "md":   12,
    "lg":   16,
    "xl":   20,
    "card": 16,
    "pill": 9999
  },

  "shadow": {
    "xs":   "0 1px 2px rgba(0,0,0,.05)",
    "card": "0 1px 3px rgba(0,0,0,.08), 0 1px 2px rgba(0,0,0,.04)",
    "pop":  "0 8px 24px rgba(0,0,0,.12), 0 2px 8px rgba(0,0,0,.06)",
    "modal":"0 20px 60px rgba(0,0,0,.18)"
  },

  "motion": {
    "fast":    "100ms",
    "base":    "180ms",
    "slow":    "300ms",
    "ease":    "cubic-bezier(.2,.8,.2,1)",
    "spring":  "cubic-bezier(.34,1.56,.64,1)"
  },

  "layout": {
    "nav-height-mobile":  56,
    "header-height":      60,
    "sidebar-width":      240,
    "content-max-width":  1200,
    "card-min-width":     280,
    "bottom-nav-height":  64
  },

  "breakpoint": {
    "sm":  480,
    "md":  768,
    "lg":  1024,
    "xl":  1280
  },

  "icon-set": "Lucide React (MIT)",
  "font-source": "Google Fonts — Inter + Be Vietnam Pro (open license)"
}
